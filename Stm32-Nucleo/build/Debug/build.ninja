  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Projetos\Simulador-IA\Stm32-Nucleo\build\Debug && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\Projetos\Simulador-IA\Stm32-Nucleo -BD:\Projetos\Simulador-IA\Stm32-Nucleo\build\Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

