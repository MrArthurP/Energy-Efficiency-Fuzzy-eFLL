{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar OpenOCD",
            "type": "shell",
            "command": "C:/arm-compiler/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "args": [
                "-s",
                "C:/arm-compiler/xpack-openocd-0.12.0-7/openocd/scripts",
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f3x.cfg",
                "-c",
                "gdb_port 50000"
            ],
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^xPack Open On-Chip Debugger.*",
                        "endsPattern": "^Info : Listening on port 50000 for gdb connections.*"
                    }
                }
            ]
        },
        {
            "label": "Flash and Run (OpenOCD)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/flash_and_run.ps1"],
            "group": { "kind": "build", "isDefault": false },
            "problemMatcher": []
        }
    ]
}
